# Puerto en el que escucha la API HTTP.
PORT=8080

# Credenciales de la base de datos Postgres propia del servicio, usadas
# tanto por el contenedor de Postgres como por DATABASE_URL.
POSTGRES_DB=REPLACE_WITH_DB_NAME
POSTGRES_USER=REPLACE_WITH_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Cadena de conexion a Postgres. El host debe ser el nombre del
# contenedor (vinculo-vial-notification-db), nunca localhost.
DATABASE_URL=postgres://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@vinculo-vial-notification-db:5432/REPLACE_WITH_DB_NAME?sslmode=disable

# Cadena de conexion a RabbitMQ. El host debe ser el nombre del
# contenedor del broker compartido (vinculo-vial-rabbitmq).
RABBITMQ_URL=REPLACE_WITH_RABBITMQ_CONNECTION_STRING

# Topologia de mensajeria declarada por vinculo-vial-core. Este servicio
# consume de ella; no la declara.
RABBITMQ_EXCHANGE=vvi.topic.exchange
ALERT_QUEUE=notification.alert-created.q
SESSIONS_REVOKED_QUEUE=notification.sessions-revoked.q

# Colas de los avisos push al emisor de una alerta (US-09). Cada una
# tiene su .retry y su .dlq, declaradas por vinculo-vial-core. El
# destinatario de la push es siempre el actor del evento. El aviso de
# alert.created reutiliza ALERT_QUEUE.
ALERT_REJECTED_QUEUE=notification.alert-rejected.q
ALERT_EXPIRED_QUEUE=notification.alert-expired.q
ALERT_SEEN_QUEUE=notification.alert-seen.q

# Cola del aviso a los duenos que reciben alertas pendientes al vincular
# su vehiculo (US-10). Tiene su .retry y su .dlq, declaradas por
# vinculo-vial-core. El evento no trae actor: el push va solo a los
# owner_ids y nunca al emisor.
ALERT_PENDING_DELIVERED_QUEUE=notification.alert-pending-delivered.q

# Cantidad maxima de reintentos antes de publicar a la DLQ.
MAX_RETRIES=5

# Ruta, dentro del contenedor, al archivo de credenciales del service
# account de Firebase Admin SDK. El archivo se monta como volumen de
# solo lectura desde el host (ver docker-compose.yml); nunca se
# versiona ni se copia a la imagen.
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# Tamanio maximo de lote por llamada de multicast a FCM.
FCM_BATCH_SIZE=500

# Timeout, en segundos, para cada llamada individual al SDK de FCM.
# Acota el tiempo que un lote puede colgar el worker ante un proveedor
# caido o degradado. Exento del presupuesto de 2000ms para "HTTP
# saliente" del contrato de resiliencia: el despacho ocurre en el
# worker asincronico, fuera de la cadena de request/response via Kong
# que ese presupuesto acota.
FCM_TIMEOUT_SECONDS=10

# Cantidad maxima de mensajes sin ACK que un canal puede tener en
# vuelo a la vez (basic.qos). Sin este limite el broker empuja toda la
# cola pendiente al proceso, sin techo de memoria.
RABBITMQ_PREFETCH=10

# Circuit breaker sobre el despacho a FCM. Con el circuito abierto,
# Dispatch falla de inmediato sin llamar al SDK (el mensaje se nackea
# sin requeue y vuelve a intentarse via la cola .retry, igual que
# cualquier otro fallo transitorio).
#   FCM_BREAKER_FAILURE_THRESHOLD: fallas de transporte del SDK dentro
#     de la ventana que abren el circuito. Un rechazo por token
#     puntual (Unregistered, InvalidArgument) no cuenta: viaja dentro
#     de una respuesta exitosa del SDK.
#   FCM_BREAKER_WINDOW_SECONDS: periodo durante el cual las fallas se
#     acumulan.
#   FCM_BREAKER_OPEN_SECONDS: tiempo que el circuito permanece abierto
#     antes de permitir un intento de prueba (half-open).
FCM_BREAKER_FAILURE_THRESHOLD=5
FCM_BREAKER_WINDOW_SECONDS=60
FCM_BREAKER_OPEN_SECONDS=30

# Timeout, en milisegundos, que Postgres aplica a cualquier consulta
# de la sesion (statement_timeout). Corta del lado del motor una
# consulta colgada, sin depender de que el codigo propague un
# deadline correctamente. 1500ms es el presupuesto de "Consulta DB"
# del contrato de resiliencia (identico en los 6 servicios).
DB_STATEMENT_TIMEOUT_MS=1500

# Limites del pool de conexiones hacia Postgres. Sin techo, una base
# lenta o caida puede acumular conexiones sin limite.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# Timeout, en segundos, que cada consulta individual de los
# repositorios impone del lado de Go (independiente del ctx del
# llamador). Complementa a DB_STATEMENT_TIMEOUT_MS: cubre el tiempo de
# espera por una conexion libre del pool, que el statement_timeout del
# motor no llega a cubrir porque todavia no hay consulta en curso.
# Margen de 500ms sobre DB_STATEMENT_TIMEOUT_MS (1500ms).
DB_QUERY_TIMEOUT_SECONDS=2

# Timeouts del servidor HTTP. Deben quedar por debajo de cualquier
# timeout que le imponga Kong u otro cliente que espera la respuesta
# (Kong aplica read=9000ms/write=9000ms hacia este servicio), por
# debajo del presupuesto de "request completo" del contrato de
# resiliencia (<=8000ms para servicios que no son Identity), y por
# encima de DB_STATEMENT_TIMEOUT_MS: un handler que solo espera a la
# base no debe cortarse antes que la base misma.
HTTP_READ_TIMEOUT_SECONDS=5
HTTP_WRITE_TIMEOUT_SECONDS=6
HTTP_IDLE_TIMEOUT_SECONDS=60
